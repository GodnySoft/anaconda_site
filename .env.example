# ========================================
# ANACONDA / OSNOVA - local and release checklist
# Заполняется вручную как локальный reference-файл.
# Реальные production secrets для GitHub Actions затем
# нужно перенести в GitHub Secrets / Variables.
# ========================================

# ----------------------------------------
# Database
# ----------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=anaconda
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/anaconda

# ----------------------------------------
# Local runtime
# ----------------------------------------
ANACONDA_WEB_PORT=26300
ANACONDA_API_PORT=26800
ANACONDA_POSTGRES_PORT=26543
ANACONDA_PGWEB_PORT=26081
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:26300,http://127.0.0.1:26300
NEXT_PUBLIC_SITE_URL=http://localhost:26300
NEXT_PUBLIC_API_URL=http://localhost:26800

# ----------------------------------------
# GitHub repository
# ----------------------------------------
GH_USER=GodnySoft
GH_REPO_NAME=anaconda_site
GH_REPO_HTTP=https://github.com/GodnySoft/anaconda_site.git
GH_REPO_SSH=git@github.com:GodnySoft/anaconda_site.git
GITHUB_DEFAULT_BRANCH=main

GITHUB_LOCAL_SSH_PRIVATE_KEY_FILE=infra/keys/github_anaconda_site
GITHUB_LOCAL_SSH_PUBLIC_KEY_FILE=infra/keys/github_anaconda_site.pub
GITHUB_LOCAL_SSH_PUBLIC_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIBmq0LUJRTnEzddhfOELxsrLvJ5UeFqmLvBupNXsxSxB github-local-access
# ----------------------------------------
# GHCR
# ----------------------------------------
GHCR_REGISTRY=ghcr.io
GHCR_NAMESPACE=godnysoft/anaconda_site
GHCR_API_IMAGE=ghcr.io/godnysoft/anaconda_site/api
GHCR_WEB_IMAGE=ghcr.io/godnysoft/anaconda_site/web

# ----------------------------------------
# Production host checklist
# ----------------------------------------
PROD_HOST=31.56.228.78
PROD_USER=deploy
PROD_APP_ROOT=/opt/anaconda-site
PROD_WEB_HEALTH_URL=http://127.0.0.1:26300/
PROD_API_HEALTH_URL=http://127.0.0.1:26800/api/v1/health

# ----------------------------------------
# Local files used to prepare GitHub secrets
# Эти переменные нужны тебе как памятка.
# Содержимое файлов переносится в GitHub Secrets вручную.
# ----------------------------------------
PROD_ENV_FILE_LOCAL=.env.prod
PROD_SSH_PRIVATE_KEY_FILE=infra/keys/prod_deploy_ed25519
PROD_SSH_PUBLIC_KEY_FILE=infra/keys/prod_deploy_ed25519.pub

# ----------------------------------------
# GitHub Actions Secrets checklist
# В GitHub нужно создать secrets с ИМЕННО такими именами.
# Значения сюда можно заносить как reference, но Actions читают
# их только из GitHub Secrets / Variables.
# ----------------------------------------
GITHUB_SECRET_PROD_HOST=
GITHUB_SECRET_PROD_USER=
GITHUB_SECRET_PROD_SSH_PRIVATE_KEY=
GITHUB_SECRET_PROD_ENV_FILE=
GITHUB_SECRET_PROD_GHCR_USERNAME=
GITHUB_SECRET_PROD_GHCR_TOKEN=

# ----------------------------------------
# GitHub Actions Variables checklist
# В GitHub -> Settings -> Secrets and variables -> Actions -> Variables
# ----------------------------------------
GITHUB_VAR_PROD_APP_ROOT=/opt/anaconda-site
GITHUB_VAR_PROD_WEB_HEALTH_URL=http://127.0.0.1:26300/
GITHUB_VAR_PROD_API_HEALTH_URL=http://127.0.0.1:26800/api/v1/health

# ----------------------------------------
# Legacy / temporary values kept for current test environment
# ----------------------------------------
PROD_ROOT_PASS=VFw-nzt-7Cc-XqH
PROD_IP=31.56.228.78